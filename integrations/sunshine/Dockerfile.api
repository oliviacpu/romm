# The recorded base image requires its existing root init process.
# trunk-ignore-all(trivy/DS-0002,checkov/CKV_DOCKER_3)
FROM romm-local-base:5.4.1
COPY backend/main.py /backend/main.py
COPY backend/endpoints/emulation.py /backend/endpoints/emulation.py
COPY backend/endpoints/responses/emulation.py /backend/endpoints/responses/emulation.py
COPY backend/endpoints/roms/upload.py /backend/endpoints/roms/upload.py
COPY backend/endpoints/search.py /backend/endpoints/search.py
COPY backend/handler/emulation/ /backend/handler/emulation/
COPY backend/handler/metadata/libretro_handler.py /backend/handler/metadata/libretro_handler.py
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 CMD ["/src/.venv/bin/python", "-c", "import os, urllib.request; urllib.request.urlopen(\"http://127.0.0.1:\" + os.environ.get(\"ROMM_PORT\", \"8080\") + \"/api/heartbeat\", timeout=5)"]
